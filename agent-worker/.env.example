LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Same key the main app uses for the copilot — the Realtime API is billed
# separately from regular chat completions, keep an eye on usage.
OPENAI_API_KEY=

# Must match AGENT_NAME in the main app's .env / wrangler.jsonc, or
# dispatched jobs will never reach this worker.
AGENT_NAME=oksana-support-agent

# Optional: pin to a specific Realtime model instead of the plugin default.
OPENAI_REALTIME_MODEL=
