# Copy to .env for local `npm run dev`. For a deployed Worker, set these as
# vars/secrets in wrangler.jsonc or `wrangler secret put` instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit project (Cloud or self-hosted) — used to create rooms and mint
# short-lived access tokens. LIVEKIT_URL is the wss:// URL the browser
# connects to and is returned to the client; the API key/secret never leave
# the server (they sign tokens, they don't get sent anywhere).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Used server-side only, to power the AI copilot's suggested replies /
# intent / sentiment from the live transcript. Never sent to the browser.
OPENAI_API_KEY=

# Name the "invite AI agent" button dispatches through LiveKit's Agent
# Dispatch API. The separately-run agent-worker/ process (see its README)
# must register under this same name for the dispatch to reach anything —
# without it running, dispatch still succeeds, there's just no worker to
# pick the job up.
AGENT_NAME=oksana-support-agent
