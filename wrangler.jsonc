{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "oksana",
	"compatibility_date": "2026-09-16",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"vars": {
		"SUPABASE_URL": "",
		"SUPABASE_SERVICE_ROLE_KEY": ""
	}
}
